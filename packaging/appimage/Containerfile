# Build environment for the Linux AppImage. Ubuntu 24.04 is the oldest base
# that ships libmpv.so.2, and its glibc (2.39) is the floor the AppImage
# runs on. Versions are pinned to match the dev toolchain.
FROM ubuntu:24.04

ARG FLUTTER_VERSION=3.47.7
ARG RUST_VERSION=1.93.1
ARG RINF_VERSION=8.10.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates clang cmake curl file git ninja-build \
      pkg-config unzip xz-utils zip \
      libgtk-3-dev liblzma-dev libmpv-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" \
      https://github.com/flutter/flutter.git /opt/flutter
ENV PATH="/opt/flutter/bin:/root/.cargo/bin:${PATH}"
# Flutter's artifact tarballs carry uids outside the rootless-podman range;
# as root, tar would try to restore them and fail.
ENV TAR_OPTIONS=--no-same-owner
RUN flutter config --no-analytics --no-cli-animations \
    && flutter precache --linux

RUN curl -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && cargo install rinf_cli --version "${RINF_VERSION}" --locked \
    && rm -rf /root/.cargo/registry

# linuxdeploy is itself an AppImage; extract it so it runs without FUSE.
RUN curl -sSfL -o /tmp/linuxdeploy.AppImage \
      https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && chmod +x /tmp/linuxdeploy.AppImage \
    && cd /opt && /tmp/linuxdeploy.AppImage --appimage-extract >/dev/null \
    && mv squashfs-root linuxdeploy \
    && ln -s /opt/linuxdeploy/AppRun /usr/local/bin/linuxdeploy \
    && rm /tmp/linuxdeploy.AppImage

WORKDIR /work
